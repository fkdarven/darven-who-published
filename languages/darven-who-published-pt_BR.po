#. Plugin Name of the plugin
#: darven-who-published.php
msgid "Who Published – Post Publisher Column"
msgstr "Quem Publicou – Coluna de Publicador da Postagem"

#. Description of the plugin
#: darven-who-published.php
msgid "Shows who actually clicked Publish beside the credited post author."
msgstr "Mostra quem realmente clicou em Publicar ao lado do autor creditado da postagem."

#. Author of the plugin
#: darven-who-published.php
msgid "Darven"
msgstr "Darven"

