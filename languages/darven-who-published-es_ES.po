#. Plugin Name of the plugin
#: darven-who-published.php
msgid "Who Published – Post Publisher Column"
msgstr "Quién publicó – Columna de publicador de entradas"

#. Description of the plugin
#: darven-who-published.php
msgid "Shows who actually clicked Publish beside the credited post author."
msgstr "Muestra quién hizo clic realmente en Publicar junto al autor acreditado de la entrada."

#. Author of the plugin
#: darven-who-published.php
msgid "Darven"
msgstr "Darven"

